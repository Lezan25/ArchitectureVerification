<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>const int N = 1;
typedef int[0,N-1] idType;
typedef int[0,1] schedType;

const int T_FO  = 6;
const int T_DET = 11;
const int T_INT = 10;
const int T_E2E = 25;

broadcast chan ready[idType];
broadcast chan assignW[idType];
broadcast chan alive[idType];
broadcast chan schedulerDeath[schedType];
broadcast chan schedulerAlive[schedType];

bool undetected[idType];
bool unhandled[idType];
bool failover[idType];

bool failoverInProgress = false;

void markFailover() {
    for (i : idType) {
        failover[i] = true;
    }
    failoverInProgress = true;
}</declaration>
	<template>
		<name>Scheduler_LifeCycle</name>
		<parameter>schedType sId</parameter>
		<declaration>clock c = 0;
int[0,16] life = 0;
clock tDown;</declaration>
		<location id="id0" x="-340" y="-8">
			<name x="-360" y="-42">idle</name>
			<urgent/>
		</location>
		<location id="id1" x="17" y="-8">
			<name x="34" y="-25">active</name>
			<label kind="invariant" x="34" y="-8">c&lt;=5 &amp;&amp; c&lt;=5*life</label>
		</location>
		<location id="id2" x="17" y="263">
			<name x="34" y="246">passive</name>
			<label kind="invariant" x="34" y="263">c&lt;=6</label>
		</location>
		<init ref="id0"/>
		<transition id="id3">
			<source ref="id2"/>
			<target ref="id2"/>
			<label kind="synchronisation" x="-17" y="374">schedulerAlive[1-sId]?</label>
			<label kind="assignment" x="110" y="340">c=0</label>
			<nail x="17" y="374"/>
			<nail x="127" y="374"/>
		</transition>
		<transition id="id4">
			<source ref="id1"/>
			<target ref="id1"/>
			<label kind="guard" x="-17" y="-110">c==5</label>
			<label kind="synchronisation" x="0" y="-136">schedulerAlive[sId]!</label>
			<label kind="assignment" x="102" y="-93">c=0, life--</label>
			<nail x="17" y="-119"/>
			<nail x="136" y="-119"/>
			<nail x="42" y="-34"/>
		</transition>
		<transition id="id5">
			<source ref="id0"/>
			<target ref="id2"/>
			<label kind="guard" x="-391" y="229">sId!=0</label>
			<label kind="assignment" x="-331" y="263">c=0</label>
			<nail x="-340" y="263"/>
		</transition>
		<transition id="id6">
			<source ref="id2"/>
			<target ref="id1"/>
			<label kind="select" x="-102" y="195">i:int[0,3]</label>
			<label kind="guard" x="-76" y="161">c==6</label>
			<label kind="synchronisation" x="-161" y="119">schedulerAlive[sId]!</label>
			<label kind="assignment" x="-161" y="51">c=0, life=16-i,
failoverInProgress=false</label>
			<nail x="-59" y="127"/>
		</transition>
		<transition id="id7">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="guard" x="68" y="51">c==5*life</label>
			<label kind="synchronisation" x="68" y="119">schedulerDeath[sId]!</label>
			<label kind="assignment" x="25" y="178">c=0, life=0, tDown=0, markFailover()</label>
			<nail x="93" y="127"/>
		</transition>
		<transition id="id8">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="select" x="-255" y="-25">i:int[0,3]</label>
			<label kind="guard" x="-127" y="-25">sId==0</label>
			<label kind="assignment" x="-221" y="-8">c=0, life=16-i</label>
		</transition>
	</template>
	<template>
		<name>Scheduler_MachineChecker</name>
		<parameter>schedType sId, idType mId</parameter>
		<declaration>clock c = 0;</declaration>
		<location id="id9" x="42" y="-229">
			<name x="59" y="-238">start</name>
			<committed/>
		</location>
		<location id="id10" x="-76" y="-442">
			<name x="-96" y="-476">idle</name>
		</location>
		<location id="id11" x="637" y="-51">
			<name x="654" y="-68">assignWork</name>
			<label kind="invariant" x="654" y="-51">c&lt;=5</label>
		</location>
		<location id="id12" x="-680" y="-51">
			<name x="-790" y="-68">recoverLoss</name>
			<label kind="invariant" x="-731" y="-51">c&lt;=5</label>
		</location>
		<location id="id13" x="-76" y="-51">
			<name x="-59" y="-76">inactive</name>
		</location>
		<location id="id14" x="-76" y="323">
			<name x="-93" y="331">monitoring</name>
			<label kind="invariant" x="-93" y="348">c&lt;=11</label>
		</location>
		<init ref="id9"/>
		<transition id="id15">
			<source ref="id9"/>
			<target ref="id13"/>
			<label kind="guard" x="-25" y="-161">sId!=0</label>
		</transition>
		<transition id="id16">
			<source ref="id9"/>
			<target ref="id10"/>
			<label kind="guard" x="-34" y="-314">sId==0</label>
		</transition>
		<transition id="id17">
			<source ref="id13"/>
			<target ref="id14"/>
			<label kind="synchronisation" x="-297" y="127">schedulerAlive[sId]?</label>
			<label kind="assignment" x="-221" y="153">c=0</label>
			<nail x="-255" y="110"/>
		</transition>
		<transition id="id18">
			<source ref="id10"/>
			<target ref="id14"/>
			<label kind="synchronisation" x="136" y="-178">alive[mId]?</label>
			<label kind="assignment" x="178" y="-161">c=0</label>
			<nail x="195" y="-195"/>
		</transition>
		<transition id="id19">
			<source ref="id10"/>
			<target ref="id11"/>
			<label kind="synchronisation" x="246" y="-289">ready[mId]?</label>
			<label kind="assignment" x="340" y="-238">c=0</label>
			<nail x="340" y="-212"/>
		</transition>
		<transition id="id20">
			<source ref="id10"/>
			<target ref="id13"/>
			<label kind="synchronisation" x="-195" y="-238">schedulerDeath[sId]?</label>
			<nail x="-76" y="-187"/>
		</transition>
		<transition id="id21">
			<source ref="id11"/>
			<target ref="id14"/>
			<label kind="guard" x="637" y="263">c==5</label>
			<label kind="synchronisation" x="518" y="323">assignW[mId]!</label>
			<label kind="assignment" x="272" y="323">c=0</label>
			<nail x="637" y="323"/>
		</transition>
		<transition id="id22">
			<source ref="id11"/>
			<target ref="id13"/>
			<label kind="synchronisation" x="221" y="-68">schedulerDeath[sId]?</label>
			<nail x="297" y="-51"/>
		</transition>
		<transition id="id23">
			<source ref="id14"/>
			<target ref="id14"/>
			<label kind="synchronisation" x="-348" y="357">alive[mId]?</label>
			<label kind="assignment" x="-306" y="306">c=0</label>
			<nail x="-263" y="408"/>
			<nail x="-331" y="323"/>
		</transition>
		<transition id="id24">
			<source ref="id14"/>
			<target ref="id12"/>
			<label kind="guard" x="-518" y="59">c==11</label>
			<label kind="assignment" x="-654" y="17">undetected[mId]=false, c=0</label>
			<nail x="-433" y="102"/>
		</transition>
		<transition id="id25">
			<source ref="id14"/>
			<target ref="id11"/>
			<label kind="synchronisation" x="153" y="170">ready[mId]?</label>
			<label kind="assignment" x="255" y="85">undetected[mId]=false,
unhandled[mId]=false, c=0</label>
			<nail x="289" y="136"/>
		</transition>
		<transition id="id26">
			<source ref="id14"/>
			<target ref="id13"/>
			<label kind="synchronisation" x="-170" y="93">schedulerDeath[sId]?</label>
			<nail x="-76" y="161"/>
		</transition>
		<transition id="id27">
			<source ref="id12"/>
			<target ref="id10"/>
			<label kind="guard" x="-501" y="-204">c==5</label>
			<label kind="assignment" x="-433" y="-280">unhandled[mId]=false</label>
		</transition>
		<transition id="id28">
			<source ref="id12"/>
			<target ref="id11"/>
			<label kind="synchronisation" x="-365" y="-527">ready[mId]?</label>
			<label kind="assignment" x="102" y="-527">unhandled[mId]=false, c=0</label>
			<nail x="-680" y="-501"/>
			<nail x="637" y="-501"/>
		</transition>
		<transition id="id29">
			<source ref="id12"/>
			<target ref="id13"/>
			<label kind="synchronisation" x="-450" y="-68">schedulerDeath[sId]?</label>
			<nail x="-306" y="-51"/>
		</transition>
	</template>
	<template>
		<name>CuttingMachine</name>
		<parameter>idType mId</parameter>
		<declaration>clock c = 0;
int[0,16] k = 0;
clock tFail;</declaration>
		<location id="id30" x="-204" y="-373">
			<name x="-187" y="-391">idle</name>
			<label kind="invariant" x="-187" y="-374">c&lt;=5</label>
		</location>
		<location id="id31" x="-204" y="-153">
			<name x="-187" y="-179">working</name>
			<label kind="invariant" x="-187" y="-162">c&lt;=5 &amp;&amp; c&lt;=5*k</label>
		</location>
		<location id="id32" x="-527" y="-153">
			<name x="-595" y="-170">broken</name>
			<label kind="invariant" x="-595" y="-153">c&lt;=5*k</label>
		</location>
		<init ref="id30"/>
		<transition id="id33">
			<source ref="id30"/>
			<target ref="id30"/>
			<label kind="guard" x="-246" y="-476">c==5</label>
			<label kind="synchronisation" x="-187" y="-501">ready[mId]!</label>
			<label kind="assignment" x="-119" y="-459">c=0, k=(k&lt;3 ? k+1 : 3)</label>
			<nail x="-204" y="-484"/>
			<nail x="-85" y="-484"/>
		</transition>
		<transition id="id34">
			<source ref="id30"/>
			<target ref="id31"/>
			<label kind="select" x="-195" y="-314">i:int[0,3]</label>
			<label kind="synchronisation" x="-195" y="-289">assignW[mId]?</label>
			<label kind="assignment" x="-195" y="-263">c=0, k=16-i,
failover[mId]=false</label>
		</transition>
		<transition id="id35">
			<source ref="id31"/>
			<target ref="id31"/>
			<label kind="guard" x="-110" y="-86">c==5</label>
			<label kind="synchronisation" x="-102" y="-43">alive[mId]!</label>
			<label kind="assignment" x="-255" y="-43">c=0, k--,
failover[mId]=failoverInProgress</label>
			<nail x="-85" y="-43"/>
			<nail x="-204" y="-43"/>
		</transition>
		<transition id="id36">
			<source ref="id31"/>
			<target ref="id32"/>
			<label kind="select" x="-365" y="-170">i:int[0,2]</label>
			<label kind="guard" x="-476" y="-170">c==5*k</label>
			<label kind="assignment" x="-450" y="-153">k=7-i+k, tFail=0,
undetected[mId]=true,
unhandled[mId]=true</label>
		</transition>
		<transition id="id37">
			<source ref="id32"/>
			<target ref="id30"/>
			<label kind="guard" x="-586" y="-272">c==5*k</label>
			<label kind="assignment" x="-510" y="-416">c=0, k=0,
failover[mId]=failoverInProgress</label>
			<nail x="-527" y="-374"/>
		</transition>
	</template>
	<system>system Scheduler_LifeCycle, Scheduler_MachineChecker, CuttingMachine;</system>
	<queries>
		<option key="--diagnostic" value="1"/>
		<query>
			<formula>A[] !(Scheduler_LifeCycle(0).active &amp;&amp; Scheduler_LifeCycle(1).active)</formula>
			<comment>AV-1: At no time shall more than one scheduler be active.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 21:38:44 +0200">
			</result>
		</query>
		<query>
			<formula>A[] ((Scheduler_LifeCycle(0).passive &amp;&amp; Scheduler_LifeCycle(1).passive) imply (Scheduler_LifeCycle(0).tDown &lt;= T_FO || Scheduler_LifeCycle(1).tDown &lt;= T_FO))</formula>
			<comment>AV-2: If the active scheduler fails, a spare shall become active within T_FO (6 s).</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 21:38:47 +0200">
			</result>
		</query>
		<query>
			<formula>A[] forall (m : idType) ((CuttingMachine(m).broken &amp;&amp; undetected[m] &amp;&amp; !failover[m]) imply CuttingMachine(m).c &lt;= T_DET)</formula>
			<comment>AV-3: A silent machine shall be declared failed within T_DET (11 s) of its last heartbeat, while the detecting scheduler stays active.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 21:38:48 +0200">
			</result>
		</query>
		<query>
			<formula>A[] forall (s : schedType) forall (m : idType) (Scheduler_MachineChecker(s, m).recoverLoss imply !CuttingMachine(m).working)</formula>
			<comment>AV-4: A machine that keeps sending heartbeats shall never be declared failed.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 21:38:49 +0200">
			</result>
		</query>
		<query>
			<formula>A[] forall (m : idType) ((CuttingMachine(m).idle &amp;&amp; !failover[m]) imply CuttingMachine(m).c &lt;= T_INT - 5*CuttingMachine(m).k)</formula>
			<comment>AV-6: A ready machine shall be started within T_INT (10 s), while the scheduler stays active. (Observer d == c + 5*k.) AV-5 has no query: it is the invariant c&lt;=5 of recoverLoss.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 21:38:51 +0200">
			</result>
		</query>
		<query>
			<formula>A[] forall (m : idType) (unhandled[m] imply CuttingMachine(m).tFail &lt;= T_E2E)</formula>
			<comment>AV-7: Every machine failure shall be handled within T_E2E (25 s), regardless of scheduler failures. EXPECTED TO FAIL.</comment>
			<result outcome="failure" type="quality" timestamp="2026-09-22 22:24:45 +0200">
				<option key="--diagnostic" value="1"/>
			</result>
		</query>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>AV-9: The model shall be free of deadlocks.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 21:38:53 +0200">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; exists (m : idType) (unhandled[m] &amp;&amp; CuttingMachine(m).tFail &gt; T_E2E)</formula>
			<comment>Witness for AV-7: produces the violating trace directly.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 21:38:54 +0200">
			</result>
		</query>
	</queries>
</nta>
