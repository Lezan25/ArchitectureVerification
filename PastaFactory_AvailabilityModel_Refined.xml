	<template>
		<name>CuttingMachine</name>
		<parameter>idType mId</parameter>
		<declaration>clock c = 0;
int[0,16] k = 0;
clock tFail;</declaration>
		<location id="id33" x="-204" y="-373">
			<name x="-187" y="-391">idle</name>
			<label kind="invariant" x="-187" y="-374">c&lt;=5</label>
		</location>
		<location id="id34" x="-204" y="-110">
			<name x="-187" y="-136">working</name>
			<label kind="invariant" x="-187" y="-119">c&lt;=5 &amp;&amp; c&lt;=5*k</label>
		</location>
		<location id="id35" x="-527" y="-110">
			<name x="-595" y="-127">broken</name>
			<label kind="invariant" x="-595" y="-110">c&lt;=5*k</label>
		</location>
		<init ref="id33"/>
		<transition id="id36">
			<source ref="id33"/>
			<target ref="id33"/>
			<label kind="guard" x="-238" y="-476">c==5</label>
			<label kind="synchronisation" x="-195" y="-501">ready[mId]!</label>
			<label kind="assignment" x="-110" y="-467">c=0, k=(k&lt;3 ? k+1 : 3)</label>
			<nail x="-204" y="-484"/>
			<nail x="-85" y="-484"/>
		</transition>
		<transition id="id37">
			<source ref="id33"/>
			<target ref="id34"/>
			<label kind="select" x="-204" y="-306">i:int[0,3]</label>
			<label kind="synchronisation" x="-204" y="-272">assignW[mId]?</label>
			<label kind="assignment" x="-204" y="-238">c=0, k=16-i, lastHb[mId]=0,
failover[mId]=false</label>
		</transition>
		<transition id="id38">
			<source ref="id34"/>
			<target ref="id34"/>
			<label kind="guard" x="-246" y="-25">c==5</label>
			<label kind="synchronisation" x="-195" y="-8">alive[mId]!</label>
			<label kind="assignment" x="-93" y="-42">c=0, k--, lastHb[mId]=0,
failover[mId]=failoverInProgress</label>
			<nail x="-204" y="-8"/>
			<nail x="-93" y="-8"/>
		</transition>
		<transition id="id39">
			<source ref="id34"/>
			<target ref="id35"/>
			<label kind="select" x="-340" y="-127">i:int[0,2]</label>
			<label kind="guard" x="-459" y="-127">c==5*k</label>
			<label kind="assignment" x="-442" y="-110">k=7-i+k, tFail=0,
undetected[mId]=true,
unhandled[mId]=true</label>
		</transition>
		<transition id="id40">
			<source ref="id35"/>
			<target ref="id33"/>
			<label kind="guard" x="-552" y="-229">c==5*k</label>
			<label kind="assignment" x="-646" y="-297">c=0, k=0,
failover[mId]=failoverInProgress</label>
			<nail x="-527" y="-374"/>
		</transition>
	</template>
	<system>system Scheduler_LifeCycle, Scheduler_MachineChecker, CuttingMachine;</system>
	<queries>
		<query>
			<formula>A[] !(Scheduler_LifeCycle(0).active &amp;&amp; Scheduler_LifeCycle(1).active)</formula>
			<comment>AV-1: At no time shall more than one scheduler be active.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 23:14:46 +0200">
			</result>
		</query>
		<query>
			<formula>A[] ((Scheduler_LifeCycle(0).passive &amp;&amp; Scheduler_LifeCycle(1).passive) imply (Scheduler_LifeCycle(0).tDown &lt;= T_FO || Scheduler_LifeCycle(1).tDown &lt;= T_FO))</formula>
			<comment>AV-2: If the active scheduler fails, a spare shall become active within T_FO (4 s).</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 23:14:47 +0200">
			</result>
		</query>
		<query>
			<formula>A[] forall (m : idType) ((CuttingMachine(m).broken &amp;&amp; undetected[m] &amp;&amp; !failover[m]) imply CuttingMachine(m).c &lt;= T_DET)</formula>
			<comment>AV-3: A silent machine shall be declared failed within T_DET (11 s) of its last heartbeat, while the detecting scheduler stays active.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 23:14:49 +0200">
			</result>
		</query>
		<query>
			<formula>A[] forall (s : schedType) forall (m : idType) (Scheduler_MachineChecker(s, m).recoverLoss imply !CuttingMachine(m).working)</formula>
			<comment>AV-4: A machine that keeps sending heartbeats shall never be declared failed.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 23:14:50 +0200">
			</result>
		</query>
		<query>
			<formula>A[] forall (m : idType) ((CuttingMachine(m).idle &amp;&amp; !failover[m]) imply CuttingMachine(m).c &lt;= T_INT - 5*CuttingMachine(m).k)</formula>
			<comment>AV-6: A ready machine shall be started within T_INT (10 s), while the scheduler stays active. (Observer d == c + 5*k.) AV-5 has no query: it is the invariant c&lt;=5 of recoverLoss.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 23:14:51 +0200">
			</result>
		</query>
		<query>
			<formula>A[] forall (m : idType) (unhandled[m] imply CuttingMachine(m).tFail &lt;= T_E2E)</formula>
			<comment>AV-7: Every machine failure shall be handled within T_E2E (25 s), regardless of scheduler failures.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 23:14:53 +0200">
			</result>
		</query>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>AV-8: The model shall be free of deadlocks.</comment>
			<result outcome="success" type="quality" timestamp="2026-09-22 23:15:21 +0200">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; exists (m : idType) (unhandled[m] &amp;&amp; CuttingMachine(m).tFail &gt; T_E2E)</formula>
			<comment>Counterpart of the baseline witness: EXPECTED TO BE UNSATISFIED.</comment>
			<result outcome="failure" type="quality" timestamp="2026-09-22 23:14:54 +0200">
			</result>
		</query>
	</queries>
</nta>
