		</transition>
		<transition id="id18">
			<source ref="id13"/>
			<target ref="id15"/>
			<label kind="synchronisation" x="-297" y="25">schedulerAlive[sId]?</label>
		</transition>
		<transition id="id19">
			<source ref="id15"/>
			<target ref="id14"/>
			<label kind="guard" x="-374" y="178">lastHb[mId]&lt;=T_DET</label>
			<label kind="assignment" x="-221" y="238">c=0</label>
			<nail x="-280" y="212"/>
		</transition>
		<transition id="id20">
