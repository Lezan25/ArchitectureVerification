<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>const int N = 1;
typedef int[0,N-1] idType;
typedef int[0,1] schedType;

const int T_FO  = 4;
const int T_DET = 11;
const int T_INT = 10;
const int T_E2E = 25;

broadcast chan ready[idType];
broadcast chan assignW[idType];
broadcast chan alive[idType];
broadcast chan schedulerDeath[schedType];
broadcast chan schedulerAlive[schedType];

clock lastHb[idType];

bool undetected[idType];
bool unhandled[idType];
bool failover[idType];

bool failoverInProgress = false;

void markFailover() {
    for (i : idType) {
        failover[i] = true;
    }
    failoverInProgress = true;
}</declaration>
	<template>
		<name>Scheduler_LifeCycle</name>
		<parameter>schedType sId</parameter>
		<declaration>clock c = 0;
int[0,26] life = 0;
clock tDown;</declaration>
		<location id="id0" x="-340" y="-8">
			<name x="-360" y="-42">idle</name>
			<urgent/>
		</location>
		<location id="id1" x="17" y="-8">
			<name x="34" y="-25">active</name>
			<label kind="invariant" x="34" y="-8">c&lt;=3 &amp;&amp; c&lt;=3*life</label>
		</location>
		<location id="id2" x="17" y="263">
			<name x="42" y="238">passive</name>
			<label kind="invariant" x="42" y="255">c&lt;=4</label>
		</location>
		<init ref="id0"/>
		<transition id="id3">
			<source ref="id2"/>
			<target ref="id2"/>
			<label kind="synchronisation" x="0" y="357">schedulerAlive[1-sId]?</label>
			<label kind="assignment" x="110" y="331">c=0</label>
			<nail x="17" y="357"/>
			<nail x="119" y="357"/>
		</transition>
		<transition id="id4">
			<source ref="id1"/>
			<target ref="id1"/>
			<label kind="guard" x="-17" y="-102">c==3</label>
			<label kind="synchronisation" x="-8" y="-119">schedulerAlive[sId]!</label>
			<label kind="assignment" x="102" y="-93">c=0, life--</label>
			<nail x="17" y="-102"/>
			<nail x="110" y="-102"/>
		</transition>
		<transition id="id5">
			<source ref="id0"/>
			<target ref="id2"/>
			<label kind="guard" x="-391" y="212">sId!=0</label>
			<label kind="assignment" x="-331" y="263">c=0</label>
			<nail x="-340" y="263"/>
		</transition>
		<transition id="id6">
			<source ref="id2"/>
			<target ref="id1"/>
			<label kind="select" x="-76" y="187">i:int[0,3]</label>
			<label kind="guard" x="-59" y="153">c==4</label>
			<label kind="synchronisation" x="-170" y="119">schedulerAlive[sId]!</label>
			<label kind="assignment" x="-170" y="59">c=0, life=26-i,
failoverInProgress=false</label>
			<nail x="-59" y="127"/>
		</transition>
		<transition id="id7">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="guard" x="76" y="68">c==3*life</label>
			<label kind="synchronisation" x="93" y="119">schedulerDeath[sId]!</label>
			<label kind="assignment" x="68" y="170">c=0, life=0, tDown=0, markFailover()</label>
			<nail x="93" y="127"/>
		</transition>
		<transition id="id8">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="select" x="-255" y="-25">i:int[0,3]</label>
			<label kind="guard" x="-119" y="-25">sId==0</label>
			<label kind="assignment" x="-212" y="-8">c=0, life=26-i</label>
		</transition>
	</template>
