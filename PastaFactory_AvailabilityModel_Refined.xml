			<nail x="-229" y="374"/>
			<nail x="-136" y="416"/>
		</transition>
		<transition id="id27">
			<source ref="id14"/>
			<target ref="id12"/>
			<label kind="guard" x="-527" y="297">lastHb[mId]==T_DET</label>
			<label kind="assignment" x="-842" y="288">undetected[mId]=false, c=0</label>
			<nail x="-680" y="314"/>
		</transition>
		<transition id="id28">
			<source ref="id14"/>
			<target ref="id11"/>
			<label kind="synchronisation" x="170" y="161">ready[mId]?</label>
			<label kind="assignment" x="280" y="59">undetected[mId]=false,
unhandled[mId]=false, c=0</label>
			<nail x="280" y="136"/>
		</transition>
		<transition id="id29">
			<source ref="id14"/>
			<target ref="id13"/>
			<label kind="synchronisation" x="-153" y="127">schedulerDeath[sId]?</label>
